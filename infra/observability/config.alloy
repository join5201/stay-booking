// o2o 프로젝트 컨테이너의 로그를 Loki로 보낸다 (이슈 236)
// 문법은 Grafana Alloy 문서 loki.source.docker 예시를 따른다

// 같은 엔진의 다른 컨테이너(테스트 DB 3307 등)는 빼고 compose 프로젝트 o2o만 본다
discovery.docker "o2o" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=o2o"]
  }
}

// Grafana에서 {service="backend"}로 고르도록 compose 서비스 이름을 라벨로 옮긴다
discovery.relabel "o2o" {
  targets = []
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "o2o" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.o2o.targets
  relabel_rules = discovery.relabel.o2o.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
