{
  "uid": "o2o-booking",
  "title": "O2O 예약과 결제",
  "description": "관측 3-3(이슈 236). 업무 지표(이슈 228)와 HTTP, DB 커넥션, 백엔드 경고 로그를 한 시간 축에 둔다. 카운터는 앱이 다시 뜨면 0부터 센다",
  "tags": [
    "o2o"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "결제 승인",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(o2o_payment_approved_total)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "예약 확정",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(o2o_booking_confirmed_total)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "보류 추정",
      "description": "승인 - 확정 - 늦은 승인 환불. 돈은 받았는데 아직 확정도 환불도 안 된 예약 수의 추정. 0이 아니면 만료 스캔이 닫아야 할 건이 남아 있다",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(o2o_payment_approved_total) - sum(o2o_booking_confirmed_total) - sum(o2o_payment_refunded_total{reason=\"late_approval\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "결제 실패",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(o2o_payment_failed_total)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "환불",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(o2o_payment_refunded_total)"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "처리 실패",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(o2o_booking_payment_result_failures_total) + sum(o2o_booking_expire_scan_failures_total)"
        }
      ],
      "description": "결제 결과를 받은 예약 쪽 처리 실패와 만료 스캔 실패의 합"
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "결제 승인과 예약 확정 (누적)",
      "description": "두 선이 벌어지면 승인은 됐는데 확정이 안 된 예약이 쌓이는 중이다",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(o2o_payment_approved_total)",
          "legendFormat": "결제 승인"
        },
        {
          "refId": "B",
          "expr": "sum(o2o_booking_confirmed_total)",
          "legendFormat": "예약 확정"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "예약 확정"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "결제 결과 (누적)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(o2o_payment_failed_total)",
          "legendFormat": "결제 실패"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (o2o_payment_refunded_total)",
          "legendFormat": "환불 {{reason}}"
        },
        {
          "refId": "C",
          "expr": "sum(o2o_booking_canceled_total)",
          "legendFormat": "예약 취소"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "만료 사유별 (누적)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (o2o_booking_expired_total)",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "처리 실패 (누적)",
      "description": "결제 결과를 받은 예약 쪽 처리가 예외로 끝난 수와 만료 스캔 한 바퀴가 예외로 끝난 수",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (o2o_booking_payment_result_failures_total)",
          "legendFormat": "결제 결과 처리 실패 {{result}}"
        },
        {
          "refId": "B",
          "expr": "sum(o2o_booking_expire_scan_failures_total)",
          "legendFormat": "만료 스캔 실패"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "custom": {
            "axisSoftMax": 5
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HTTP 요청 (초당, 상태별, actuator 제외)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "DB 커넥션 (활성, 대기)",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_active)",
          "legendFormat": "활성"
        },
        {
          "refId": "B",
          "expr": "sum(hikaricp_connections_pending)",
          "legendFormat": "대기"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "custom": {
            "axisSoftMax": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "logs",
      "title": "백엔드 경고와 오류 로그",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"backend\"} |~ \"WARN|ERROR\""
        }
      ]
    }
  ]
}
